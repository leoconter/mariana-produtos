---
import '../styles/global.css';
import { OFERTA } from '../data/oferta';

const titulo = 'Liberdade Íntima — Reduza a dor na relação em até 21 dias';
const descricao =
  'Reduza a dor, a ardência e o travamento do corpo em até 21 dias com um protocolo prático, privado e baseado em neurociência. Sem medicamentos. Sem exposição. Por Dra. Mariana Della Valentina, fisioterapeuta pélvica.';
// Canonical segue o caminho real da página (ex.: /liberdade/)
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://mariana-produtos.vercel.app').toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fdf6f0" />

    <!-- Fontes acima da dobra (itálico incluso: o acento do H1 é itálico) -->
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={OFERTA.nome} />
    <meta property="og:image" content={new URL('/og.jpg', url)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Meta Pixel: stub imediato (eventos entram na fila), script
         injetado no window.load para não competir com fontes/imagens
         pela banda no primeiro render. Nenhum evento se perde. -->
    <script is:inline define:vars={{ pixelId: OFERTA.pixelId, valor: OFERTA.preco, nome: OFERTA.nome }}>
      !(function (f) {
        if (f.fbq) return;
        var n = (f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
      })(window);
      fbq('init', pixelId);
      fbq('track', 'PageView');
      fbq('track', 'ViewContent', { content_name: nome, value: valor, currency: 'BRL' });
      addEventListener('load', function () {
        var t = document.createElement('script');
        t.async = !0;
        t.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(t);
      });
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${OFERTA.pixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
