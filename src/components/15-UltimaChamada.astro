 * + o CTA único.
 */
import Secao from './primitivos/Secao.astro';
import Cta from './primitivos/Cta.astro';
---

<Secao fundo="wash">
  <div class="mx-auto max-w-2xl text-center">
    <!-- 1ª e 2ª sentenças migraram para a abertura do hero; aqui só o fecho -->
    <h2 class="text-h2">
      <span class="text-brand">E defesa se desliga com método.</span>
    </h2>
    <div class="mt-7">
      <Cta />
    </div>
  </div>
</Secao>
