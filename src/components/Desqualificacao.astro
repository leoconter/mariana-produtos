---
/**
 * Para quem é — e para quem não é (it.02: unificado sob um H2).
 * Duas colunas no desktop, empilhadas no mobile. A honestidade
 * da segunda coluna é o que faz o bloco funcionar.
 */
const paraVoce = [
  'sente dor, ardência ou travamento na relação',
  'já tentou lubrificante ou remédio e o corpo continua fechando',
  'quer resolver em casa, no seu ritmo',
  'consegue reservar alguns minutos por dia',
];
const naoParaVoce = [
  'sua dor é recente, intensa ou veio com outros sintomas ainda não investigados',
  'você procura solução instantânea sem prática diária',
  'você espera que isso substitua acompanhamento médico',
];
---

<section class="bg-card">
  <div class="mx-auto w-full max-w-5xl px-5 py-10 sm:px-8 sm:py-14" data-reveal>
    <h2 class="text-h2">
      Para quem é — <span class="italic text-brand">e para quem não é</span>
    </h2>

    <div class="mt-6 grid gap-6 text-left sm:grid-cols-2">
      <div>
        <h3 class="text-h3">É para você se</h3>
        <ul class="mt-3 space-y-2">
          {
            paraVoce.map((item) => (
              <li class="flex items-start gap-2 text-body">
                <span class="mt-2.5 size-1 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="text-h3 text-muted">Não é para você se</h3>
        <ul class="mt-3 space-y-2">
          {
            naoParaVoce.map((item) => (
              <li class="flex items-start gap-2 text-body text-body-muted">
                <span class="mt-2.5 size-1 shrink-0 rounded-full bg-muted" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
