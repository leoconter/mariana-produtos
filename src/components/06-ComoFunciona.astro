---
/**
 * Bloco 6 — Como funciona na prática. Concreto: o que a pessoa
 * faz de verdade, dia a dia.
 * FALTA: divisão real semana 1 / semana 2 / semana 3 (não existe
 * no material atual). Quando o cliente enviar, substituir os passos
 * 2–3 pela progressão semanal.
 */
import { Picture } from 'astro:assets';
import marianaTreino from '../assets/mariana-treino.jpg';
import Secao from './primitivos/Secao.astro';

const passos = [
  {
    titulo: 'Você recebe o acesso em minutos',
    texto:
      'Logo após a confirmação do pagamento, tudo chega no seu e-mail. Abre no celular ou no computador, sem instalar nada.',
  },
  {
    titulo: 'Reserva 5 a 10 minutos do dia',
    texto:
      'Em qualquer lugar privado da sua casa, no horário que preferir. Sem equipamentos, sem exposição.',
  },
  {
    titulo: 'Segue as missões diárias por 21 dias',
    texto:
      'O ritual é progressivo: começa leve e evolui no seu tempo. Cada passo é guiado e você pode adaptar ao que sentir confortável.',
  },
];
---

<Secao fundo="surface">
  <div class="grid items-center gap-10 sm:grid-cols-2">
    <div>
      <p class="eyebrow">Como funciona na prática</p>
      <h2 class="mt-2 text-h2">
        Você só precisa de <span class="text-brand">5 a 10 minutos por dia</span>
      </h2>
      <p class="mt-3">
        O protocolo é feito 100% em casa, com total privacidade, sem equipamentos, sem
        exposição. Você acompanha no seu celular ou computador, no horário que preferir.
      </p>

      <ol class="mt-6 space-y-4">
        {
          passos.map((p, i) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-wash font-bold text-brand">
                {i + 1}
              </span>
              <div>
                <p class="font-bold text-ink">{p.titulo}</p>
                <p class="mt-0.5 text-fine">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <Picture
      src={marianaTreino}
      alt="Dra. Mariana demonstrando a prática do protocolo em casa"
      width={560}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="mx-auto w-full max-w-sm rounded-2xl object-cover"
    />
  </div>
</Secao>
