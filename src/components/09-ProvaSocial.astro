---
/**
 * Bloco 9 — Prova social. Carrossel scroll-snap em CSS puro
 * (a página atual usa carrossel JS que esconde 2 dos 3 depoimentos).
 * FALTA: substanciação do "1.500 mulheres" + depoimentos com idade
 * e especificidade (ver src/data/depoimentos.ts).
 */
import Secao from './primitivos/Secao.astro';
import { DEPOIMENTOS, PADRAO_QUE_SE_REPETE } from '../data/depoimentos';
---

<Secao fundo="branco">
  <h2 class="text-h2 text-center">
    Validado por mais de <span class="text-brand">1.500 mulheres</span>
  </h2>
  <p class="mt-3 text-center">
    Mulheres reais que estavam onde você está agora. E deram o primeiro passo.
  </p>

  <div class="carrossel mt-8" role="list" aria-label="Depoimentos">
    {
      DEPOIMENTOS.map((d) => (
        <figure
          role="listitem"
          class="w-[85%] rounded-xl border border-line bg-card-alt p-6 sm:w-96"
        >
          <p class="text-brand" aria-label="5 estrelas">
            ★★★★★
          </p>
          <blockquote class="mt-3 italic text-body">"{d.texto}"</blockquote>
          <figcaption class="mt-4 flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="flex size-9 items-center justify-center rounded-full bg-brand-wash font-bold text-brand"
            >
              {d.nome.charAt(0)}
            </span>
            <span class="font-semibold text-ink">{d.nome}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="mt-8 rounded-xl border border-brand-hairline bg-brand-wash p-6">
    <p class="eyebrow text-center">O padrão que se repete</p>
    <ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2">
      {
        PADRAO_QUE_SE_REPETE.map((p) => (
          <li class="flex items-center gap-2 text-body">
            <span class="size-1.5 shrink-0 rounded-full bg-brand-soft" aria-hidden="true" />
            {p}
          </li>
        ))
      }
    </ul>
  </div>
</Secao>
