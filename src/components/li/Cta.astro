---
/**
 * O ÚNICO botão da página. Label vem de oferta.ts — a regra
 * "mesmo texto de botão em toda a página" é estrutural.
 * Destino: âncora para a caixa de oferta (#oferta) por padrão;
 * apenas o botão DENTRO da caixa (checkout=true) vai ao Kirvano —
 * é nele que `data-checkout` liga UTM + InitiateCheckout.
 */
import { OFERTA } from '../../data/li/oferta';

interface Props {
  /** true = link real para o checkout Kirvano (só na caixa de oferta) */
  checkout?: boolean;
  /** Mostra a linha "Acesso imediato. Privado. Garantia..." abaixo.
   *  It.02: default false — a linha vive só no hero e na caixa. */
  microcopy?: boolean;
  /** Ocupa a largura toda (caixa de oferta, CTA fixo) */
  bloco?: boolean;
  classe?: string;
}
const { checkout = false, microcopy = false, bloco = false, classe = '' } = Astro.props;
---

<div class={bloco ? 'w-full' : 'inline-block'}>
  <a
    href={checkout ? OFERTA.checkoutUrl : '#oferta'}
    data-checkout={checkout ? '' : undefined}
    class:list={['btn-brand', bloco && 'w-full text-lg', classe]}
  >
    {OFERTA.ctaLabel}
    <span class:list={['arrow', checkout ? 'arrow-right' : 'arrow-down']} aria-hidden="true">
      {checkout ? '→' : '↓'}
    </span>
  </a>
  {
    microcopy && (
      <p class="mt-2 text-fine text-muted" set:text={OFERTA.microcopy} />
    )
  }
</div>
