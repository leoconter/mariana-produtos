---
/**
 * Bloco 8 — O que muda: Antes → Depois. Copy integral do bloco
 * "Promessa" da página original (os 5 pares) — o conteúdo de
 * desejo mais escaneável que existe no material. Fecha com o
 * "Imagine isso" condensado.
 */
import Secao from '../primitivos/Secao.astro';

const antes = [
  'Dor e ardência a cada tentativa',
  'Corpo travando contra sua vontade',
  'Medo constante da intimidade',
  'Evitar e fingir cansaço',
  'Culpa e vergonha em silêncio',
];
const depois = [
  'Confiança no próprio corpo',
  'Resposta natural e relaxamento',
  'Calma e segurança na intimidade',
  'Desejo e conexão com o parceiro',
  'Autonomia e autoestima restauradas',
];
---

<Secao fundo="surface">
  <p class="eyebrow">O que muda</p>
  <h2 class="mt-2 text-h2">
    Quando seu corpo <span class="italic text-brand">para de reagir com dor</span>
  </h2>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-line bg-card-alt p-5 sm:p-6">
      <p class="eyebrow text-muted">Hoje</p>
      <ul class="mt-3 space-y-2.5 text-left">
        {
          antes.map((item) => (
            <li class="flex items-start gap-2.5 text-body text-muted">
              <span class="mt-2.5 size-1 shrink-0 rounded-full bg-faint" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- It.02: coluna "Depois" na cor da marca — o contraste faz o trabalho -->
    <div class="rounded-2xl bg-brand p-5 sm:p-6">
      <p class="eyebrow text-white/85">Depois dos 21 dias</p>
      <ul class="mt-3 space-y-2.5 text-left">
        {
          depois.map((item) => (
            <li class="flex items-start gap-2.5 text-body font-semibold text-white">
              <span class="mt-2.5 size-1 shrink-0 rounded-full bg-white/70" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="mt-7 max-w-2xl font-serif text-h3 italic text-ink">
    Imagine: em vez de tensão, calma. Seu corpo não trava. Você está presente. Sem dor
    interrompendo. Sem culpa depois.
  </p>
</Secao>
