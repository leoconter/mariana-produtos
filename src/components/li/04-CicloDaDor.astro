---
/**
 * Bloco 4 — O ciclo que fecha o corpo. Timeline com trilho.
 * It.02: 6 etapas → 4 (as etapas de distância/autoestima/desejo
 * consolidadas na última). Fecho migrou para o Respiro 1.
 */
import Secao from '../primitivos/Secao.astro';

const passos = [
  'A tensão muscular aumenta a cada tentativa frustrada',
  'O medo se instala e vira resposta automática do corpo',
  'Você começa a evitar a intimidade, e a culpa cresce',
  'O desejo some — não porque você não quer, mas porque a dor venceu',
];
---

<Secao fundo="surface">
  <div class="lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start lg:gap-16">
    <div>
      <p class="eyebrow">Consequência silenciosa</p>
      <h2 class="mt-2 text-h2">
        Cada tentativa frustrada treina seu corpo a fechar <span class="italic text-brand">mais</span>
      </h2>
      <p class="mt-3 max-w-2xl">
        O sistema nervoso interpreta cada nova tentativa como ameaça — e responde com
        mais rigidez.
      </p>
    </div>

    <ol class="relative mx-auto mt-8 max-w-xl space-y-5 border-l border-brand-line pl-6 text-left lg:mx-0 lg:mt-2">
      {
        passos.map((p, i) => (
          <li class="relative text-body">
            <span
              class="absolute -left-[31px] top-1.5 flex size-2.5 rounded-full bg-brand"
              aria-hidden="true"
            />
            <span class="font-serif font-medium text-brand" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {' '}{p}
          </li>
        ))
      }
    </ol>
  </div>
</Secao>
