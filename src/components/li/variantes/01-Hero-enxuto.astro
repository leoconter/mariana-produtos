---
/**
 * VARIANTE B do hero (it.03) — NÃO ESTÁ NO AR.
 * 5 elementos, ~30 palavras: remove também a linha de diferenciais.
 * Para teste A/B depois que o hero da it.03 acumular dados.
 * Uso: trocar o import em src/pages/liberdade.astro.
 */
import { Picture } from 'astro:assets';
import capa from '../../../assets/li/capa-ebook.jpg';
import Cta from '../Cta.astro';
import { OFERTA } from '../../../data/li/oferta';
---

<header class="relative overflow-hidden bg-surface">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[70%]"
    style="background: radial-gradient(120% 70% at 50% -8%, color-mix(in srgb, var(--color-brand) 10%, transparent), transparent 62%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-5xl px-5 pt-6 pb-10 sm:px-8 sm:pt-10 sm:pb-14 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-20 lg:pt-16 lg:pb-20"
  >
    <div>
      <Picture
        src={capa}
        alt={`Capa do ebook ${OFERTA.nome}`}
        width={112}
        densities={[1, 2]}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        class="anim-rise mb-3 w-14 rotate-2 rounded-md shadow-md shadow-brand-line/60 lg:hidden"
      />

      <p class="anim-rise text-fine font-bold text-ink">
        Liberdade <span class="text-brand">Íntima</span>
      </p>

      <p class="anim-rise mt-3 font-serif text-body-lg font-medium text-ink" style="animation-delay: 0.06s;">
        Você não está quebrada. Seu corpo está em defesa.
      </p>

      <h1 class="anim-rise mt-2 max-w-3xl text-h1" style="animation-delay: 0.12s;">
        Reduza a dor na relação <span class="italic text-brand">em até 21 dias</span>
      </h1>

      <p class="anim-rise mt-3 max-w-xl text-body-lg" style="animation-delay: 0.16s;">
        Fisioterapia pélvica para fazer em casa, por {OFERTA.autora}.
      </p>

      <div class="anim-rise mt-5" style="animation-delay: 0.2s;">
        <Cta />
        <p class="mt-2.5 text-fine text-muted">
          Mais de 1.500 mulheres · Garantia de {OFERTA.garantiaDias} dias
        </p>
      </div>
    </div>

    <Picture
      src={capa}
      alt=""
      width={288}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="anim-rise hidden w-72 rotate-2 rounded-xl shadow-xl shadow-brand-line/60 lg:block"
      style="animation-delay: 0.26s;"
    />
  </div>
</header>
