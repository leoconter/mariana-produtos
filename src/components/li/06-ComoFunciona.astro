---
/**
 * Bloco 6 — Como funciona na prática. Concreto: o que a pessoa
 * faz de verdade, dia a dia.
 * FALTA: divisão real semana 1 / semana 2 / semana 3 (não existe
 * no material atual). Quando o cliente enviar, substituir os passos
 * 2–3 pela progressão semanal.
 */
import { Picture } from 'astro:assets';
import marianaTreino from '../../assets/li/mariana-treino.jpg';
import Secao from '../primitivos/Secao.astro';

const passos = [
  {
    titulo: 'Você recebe o acesso em minutos',
    texto: 'Tudo chega no seu e-mail. Abre no celular, sem instalar nada.',
  },
  {
    titulo: 'Reserva 5 a 10 minutos do dia',
    texto: 'Em qualquer lugar privado da casa, no horário que preferir.',
  },
  {
    titulo: 'Segue as missões diárias por 21 dias',
    texto: 'Começa leve e evolui no seu tempo. Cada passo é guiado.',
  },
];
---

<Secao fundo="surface">
  <div class="grid items-center gap-10 sm:grid-cols-2">
    <div>
      <p class="eyebrow">Como funciona na prática</p>
      <h2 class="mt-2 text-h2">
        Você só precisa de <span class="italic text-brand">5 a 10 minutos por dia</span>
      </h2>
      <p class="mt-3 max-w-md">100% em casa, sem equipamentos.</p>

      <!-- It.02: número serifado grande à esquerda, texto à direita -->
      <ol class="mx-auto mt-7 max-w-md space-y-6 text-left lg:mx-0 lg:max-w-none">
        {
          passos.map((p, i) => (
            <li class="flex items-baseline gap-4">
              <span
                class="font-serif text-[2.5rem] leading-none font-medium text-brand"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <p class="font-bold text-ink">{p.titulo}</p>
                <p class="mt-0.5 text-fine">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <Picture
      src={marianaTreino}
      alt="Dra. Mariana demonstrando a prática do protocolo em casa"
      width={560}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="mx-auto w-full max-w-sm rounded-2xl object-cover"
    />
  </div>
</Secao>
