---
/**
 * Bloco 1 — Hero. Mobile: ocupa a tela inteira (min-h-svh);
 * H1 direto ao ponto, capa grande abaixo do reforço, centrada
 * no espaço restante. Desktop: grade texto | capa.
 * (Wordmark e linha emocional removidos a pedido do Leo.)
 */
import { Picture } from 'astro:assets';
import capa from '../../assets/li/capa-ebook.jpg';
import Cta from './Cta.astro';
import { OFERTA } from '../../data/li/oferta';
---

<header class="relative overflow-hidden bg-surface">
  <!-- Atmosfera quente no topo -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[70%]"
    style="background: radial-gradient(120% 70% at 50% -8%, color-mix(in srgb, var(--color-brand) 10%, transparent), transparent 62%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto flex min-h-svh w-full max-w-5xl flex-col px-5 pt-10 pb-8 sm:px-8 lg:grid lg:min-h-0 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-20 lg:pt-16 lg:pb-20"
  >
    <div>
      <h1 class="anim-rise max-w-3xl text-h1">
        Reduza a dor na relação <span class="italic text-brand">em até 21 dias</span>
      </h1>

      <p class="anim-rise mt-3 max-w-xl text-body-lg" style="animation-delay: 0.06s;">
        Fisioterapia pélvica para fazer em casa, por {OFERTA.autora}.
      </p>

      <p class="anim-rise mt-4 text-fine font-semibold text-body" style="animation-delay: 0.1s;">
        Sem medicamentos · 5 a 10 min por dia · Sem exposição
      </p>

      <div class="anim-rise mt-5" style="animation-delay: 0.14s;">
        <Cta />
        <p class="mt-2.5 text-fine text-muted">
          Mais de 1.500 mulheres · Garantia de {OFERTA.garantiaDias} dias
        </p>
      </div>
    </div>

    <!-- Mobile: capa grande centrada no espaço restante da tela -->
    <div class="anim-rise flex flex-1 items-center justify-center pt-8 lg:hidden" style="animation-delay: 0.2s;">
      <Picture
        src={capa}
        alt={`Capa do ebook ${OFERTA.nome}`}
        width={416}
        densities={[1, 2]}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        class="w-auto max-h-[36svh] rotate-2 rounded-xl shadow-xl shadow-brand-line/60"
      />
    </div>

    <!-- Desktop: capa ao lado do texto -->
    <Picture
      src={capa}
      alt=""
      width={288}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="anim-rise hidden w-72 rotate-2 rounded-xl shadow-xl shadow-brand-line/60 lg:block"
      style="animation-delay: 0.2s;"
    />
  </div>
</header>
