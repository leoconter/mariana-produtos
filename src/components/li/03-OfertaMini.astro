---
/**
 * Bloco 3 — Oferta antecipada. Âncora de preço para quem já está
 * pronta: a página atual só revelava o preço no bloco 13.
 * O marcador #fim-oferta-mini liga o CTA fixo mobile (script único).
 */
import Cta from './Cta.astro';
import { OFERTA } from '../../data/li/oferta';
---

<section id="oferta-mini" class="bg-brand-wash border-y border-brand-hairline">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8"
    data-reveal
  >
    <div>
      <p class="font-bold text-ink">
        {OFERTA.nome} — protocolo digital de 21 dias
      </p>
      <p class="mt-1 text-fine">
        Ebook + vídeos + ritual guiado de 21 dias. Acesso imediato por e-mail,
        garantia de {OFERTA.garantiaDias} dias.
      </p>
    </div>
    <div class="shrink-0 sm:text-right">
      <p class="text-fine text-muted">
        de <s>{OFERTA.ancoragemFmt}</s> por <strong class="text-body-lg text-ink">{OFERTA.precoFmt}</strong>
      </p>
      <div class="mt-2">
        <Cta microcopy={false} />
      </div>
    </div>
  </div>
</section>
