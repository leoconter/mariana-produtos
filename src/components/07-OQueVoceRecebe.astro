---
/**
 * Bloco 7 — O que você recebe. Checklist: menos moldura, mais
 * ritmo de leitura. O comprador precisa enxergar o objeto.
 * FALTA: nº de páginas do ebook, nº/duração dos vídeos e nome da
 * plataforma de acesso.
 */
import { Picture } from 'astro:assets';
import capa from '../assets/capa-ebook.jpg';
import Secao from './primitivos/Secao.astro';
import { OFERTA } from '../data/oferta';

// Ordem: suporte na 3ª posição (alto valor percebido); bônus por último.
const entregaveis = [
  {
    titulo: 'Ebook do Método Liberdade Íntima',
    texto: 'o guia completo, passo a passo, baseado na fisioterapia pélvica.',
    /* FALTA: nº de páginas */
  },
  { titulo: 'Ritual de 21 dias', texto: 'missões diárias guiadas de 5 a 10 minutos.' },
  { titulo: 'Suporte via WhatsApp', texto: 'individual e opcional, para tirar dúvidas.' },
  {
    titulo: 'Vídeos explicativos',
    texto: 'como aplicar cada exercício, desde o primeiro dia.',
    /* FALTA: quantos vídeos, duração */
  },
  {
    titulo: 'Acesso vitalício',
    texto: 'chega por e-mail, abre no celular. Refaça quando quiser.',
    /* FALTA: nome da plataforma/área de membros */
  },
  {
    /* NOTA: bônus off-thesis, candidato a substituição */
    titulo: 'Bônus: guia da cólica',
    texto: '5 coisas que estão piorando a sua cólica.',
  },
];
---

<Secao fundo="branco">
  <div class="grid items-start gap-8 sm:grid-cols-[1fr_auto]">
    <div>
      <p class="eyebrow">Material completo</p>
      <h2 class="mt-2 text-h2">
        O que chega para você <span class="italic text-brand">hoje</span>
      </h2>

      <ul class="mt-7 max-w-xl space-y-4">
        {
          entregaveis.map((e) => (
            <li class="flex items-start gap-3">
              <span
                aria-hidden="true"
                class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-wash text-fine font-bold text-brand"
              >
                ✓
              </span>
              <p class="text-body">
                <strong class="text-ink">{e.titulo}</strong> — {e.texto}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <Picture
      src={capa}
      alt={`Capa do ebook ${OFERTA.nome}`}
      width={280}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="hidden w-36 -rotate-2 self-center rounded-lg shadow-lg shadow-brand-line/60 sm:block sm:w-56 lg:w-72"
    />
  </div>
</Secao>
