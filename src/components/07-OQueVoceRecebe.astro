---
/**
 * Bloco 7 — O que você recebe (novo e crítico): o comprador
 * precisa enxergar o objeto.
 * FALTA: nº de páginas do ebook, nº de exercícios, nº/duração dos
 * vídeos e nome da plataforma de acesso. Preencher os "___" quando
 * o cliente enviar — os cards já têm o espaço reservado.
 */
import { Picture } from 'astro:assets';
import capa from '../assets/capa-ebook.jpg';
import Secao from './primitivos/Secao.astro';
import { OFERTA } from '../data/oferta';

// Ordem: suporte na 3ª posição (alto valor percebido); bônus por último.
const entregaveis = [
  {
    titulo: 'Ebook do Método Liberdade Íntima',
    texto:
      'O guia completo, passo a passo, baseado na fisioterapia pélvica — para entender, aliviar e transformar a dor na relação.',
    /* FALTA: nº de páginas */
  },
  {
    titulo: 'Ritual de 21 dias',
    texto: 'Missões diárias guiadas de 5 a 10 minutos. Cada dia constrói sobre o anterior.',
  },
  {
    titulo: 'Suporte via WhatsApp',
    texto: 'Individual e opcional, para tirar dúvidas sobre os exercícios e o protocolo.',
  },
  {
    titulo: 'Vídeos explicativos',
    texto: 'Para te guiar na jornada inicial e mostrar como aplicar cada exercício.',
    /* FALTA: quantos vídeos, duração */
  },
  {
    titulo: 'Acesso vitalício',
    texto:
      'Chega por e-mail em minutos, abre no celular ou computador. Refaça quantas vezes quiser.',
    /* FALTA: nome da plataforma/área de membros */
  },
  {
    /* NOTA: bônus off-thesis, candidato a substituição */
    titulo: 'Bônus: guia da cólica',
    texto: '5 coisas que estão piorando a sua cólica — e o que fazer sobre cada uma.',
  },
];
---

<Secao fundo="branco">
  <div class="flex items-start justify-between gap-6">
    <div>
      <p class="eyebrow">Material completo</p>
      <h2 class="mt-2 text-h2">
        O que chega para você <span class="text-brand">hoje</span>
      </h2>
      <p class="mt-3 max-w-2xl">
        Tudo digital, tudo seu, tudo no seu ritmo. É isto que você recebe ao entrar no {OFERTA.nome}:
      </p>
    </div>
    <Picture
      src={capa}
      alt=""
      width={128}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="lazy"
      decoding="async"
      class="hidden w-28 -rotate-2 rounded-lg shadow-md sm:block"
    />
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      entregaveis.map((e) => (
        <div class="rounded-xl border border-line bg-card-alt p-5">
          <h3 class="text-h3">{e.titulo}</h3>
          <p class="mt-2 text-fine">{e.texto}</p>
        </div>
      ))
    }
  </div>
</Secao>
