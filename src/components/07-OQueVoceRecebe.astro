---
/**
 * Bloco 7 — O que você recebe. It.02: sem a capa (já está no
 * hero), lista com mais respiro e nome do entregável em peso
 * claramente maior que a descrição.
 * FALTA: nº de páginas do ebook, nº/duração dos vídeos e nome da
 * plataforma de acesso.
 */
import Secao from './primitivos/Secao.astro';

// Ordem: suporte na 3ª posição (alto valor percebido); bônus por último.
const entregaveis = [
  {
    titulo: 'Ebook do Método Liberdade Íntima',
    texto: 'o guia completo, passo a passo, baseado na fisioterapia pélvica.',
    /* FALTA: nº de páginas */
  },
  { titulo: 'Ritual de 21 dias', texto: 'missões diárias guiadas.' },
  { titulo: 'Suporte via WhatsApp', texto: 'individual e opcional, para tirar dúvidas.' },
  {
    titulo: 'Vídeos explicativos',
    texto: 'como aplicar cada exercício, desde o primeiro dia.',
    /* FALTA: quantos vídeos, duração */
  },
  {
    titulo: 'Acesso vitalício',
    texto: 'chega por e-mail, abre no celular. Refaça quando quiser.',
    /* FALTA: nome da plataforma/área de membros */
  },
  {
    /* NOTA: bônus off-thesis, candidato a substituição */
    titulo: 'Bônus: guia da cólica',
    texto: '5 coisas que estão piorando a sua cólica.',
  },
];
---

<Secao fundo="branco">
  <p class="eyebrow">Material completo</p>
  <h2 class="mt-2 text-h2">
    O que chega para você <span class="italic text-brand">hoje</span>
  </h2>

  <ul class="mt-8 max-w-2xl space-y-6">
    {
      entregaveis.map((e) => (
        <li class="flex items-start gap-3.5">
          <span
            aria-hidden="true"
            class="mt-1.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-wash text-fine font-bold text-brand"
          >
            ✓
          </span>
          <div>
            <p class="text-h3 text-ink">{e.titulo}</p>
            <p class="mt-0.5 text-fine text-muted">{e.texto}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Secao>
